{
  "name": "@qwerzl/pi-cmux-panel",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Move Pi tasks and status into a cmux panel beside the conversation",
  "license": "MIT",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "effect:check": "effect-tsgo diagnostics --project tsconfig.json --strict",
    "test": "vitest run"
  },
  "nx": { "tags": ["type:pi-extension"] },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@earendil-works/pi-tui": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
