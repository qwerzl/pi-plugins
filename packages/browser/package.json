{
  "name": "@qwerzl/pi-browser",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Native cmux browser controls and browser-harness guidance for Chrome in Pi",
  "license": "MIT",
  "keywords": ["pi-package"],
  "files": ["skills", "src"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./src/index.ts"], "skills": ["./skills"] },
  "scripts": {
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "effect:check": "effect-tsgo diagnostics --project tsconfig.json --strict",
    "test": "vitest run"
  },
  "nx": { "tags": ["type:pi-extension"] },
  "peerDependencies": { "@earendil-works/pi-ai": "*", "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
